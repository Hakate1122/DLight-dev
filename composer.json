{
    "name": "datahihi1/dlight",
    "description": "This is a PHP framework created by Datahihi1.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "psr/log": "^3",
        "datahihi1/tiny-env": ">=1.1.0"
    },
    "require-dev": {
        "rector/rector": ">=2.4",
        "phpstan/phpstan": ">=2.1",
        "phpunit/phpunit": ">=9.6"
    },
    "suggest": {
        "ext-ftp": "Required only when using the FTP storage driver in DLight\\Application\\File. Install and enable the PHP FTP extension to use FTP storage.",
        "ext-sockets": "Required only when using WebSocket server in DLight\\Application\\WebSocket. Install and enable the PHP Sockets extension to use WebSocket server."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "DLight\\": "src/"
        },
        "files": [
            "src/Helper/cli.php",
            "src/Helper/functions.php",
            "src/Helper/source.php",
            "src/Helper/TokenGenerator.php",
            "src/Helper/default_pages.php"
        ]
    },
    "scripts": {
        "CopyEnv": "@php -r \"if (is_file('.env.test') && !file_exists('.env')) { if (!copy('.env.test', '.env')) { exit(1); } }\"",
        "post-install-cmd": [
            "@CopyEnv"
        ],
        "post-update-cmd": [
            "@CopyEnv"
        ],
        "post-create-project-cmd": [
            "@CopyEnv"
        ]
    }
}
